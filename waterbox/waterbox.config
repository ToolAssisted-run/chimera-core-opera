      "P1 Stick RT",
      "P1 Gun Trigger",
      "P1 Gun Select",
      "P1 Gun Reload",
      "P1 Gun Off-Screen",
      "P1 Arcade Gun Trigger",
      "P1 Arcade Gun Select",
      "P1 Arcade Gun Start",
      "P1 Arcade Gun Reload",
      "P1 Arcade Gun Aux A",
      "P1 Arcade Gun Off-Screen",
      "P1 Trackball Start P1",
      "P1 Trackball Start P2",
      "P1 Trackball Coin P1",
      "P1 Trackball Coin P2",
      "P1 Trackball Service",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right",
      "P2 X",
      "P2 P",
      "P2 A",
      "P2 B",
      "P2 C",
      "P2 L",
      "P2 R",
      "P2 Mouse Left",
      "P2 Mouse Middle",
      "P2 Mouse Right",
      "P2 Mouse Fourth",
      "P2 Stick Up",
      "P2 Stick Down",
      "P2 Stick Left",
      "P2 Stick Right",
      "P2 Stick Fire",
      "P2 Stick A",
      "P2 Stick B",
      "P2 Stick C",
      "P2 Stick X",
      "P2 Stick P",
      "P2 Stick LT",
      "P2 Stick RT",
      "P2 Gun Trigger",
      "P2 Gun Select",
      "P2 Gun Reload",
      "P2 Gun Off-Screen",
      "P2 Arcade Gun Trigger",
      "P2 Arcade Gun Select",
      "P2 Arcade Gun Start",
      "P2 Arcade Gun Reload",
      "P2 Arcade Gun Aux A",
      "P2 Arcade Gun Off-Screen",
      "P2 Trackball Start P1",
      "P2 Trackball Start P2",
      "P2 Trackball Coin P1",
      "P2 Trackball Coin P2",
      "P2 Trackball Service"
    ],
    "axes": [
      {
        "name": "P1 Mouse X",
        "min": -64,
        "max": 64,
        "neutral": 0
      },
      {
        "name": "P1 Mouse Y",
        "min": -64,
        "max": 64,
        "neutral": 0
      },
