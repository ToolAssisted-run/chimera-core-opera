  "settings": [
    {
      "name": "systemType",
      "display": "setting.systemtype",
      "type": "enum",
      "options": [
        "panasonicFZ1U",
        "panasonicFZ1E",
        "panasonicFZ1J",
        "panasonicFZ10U",
        "panasonicFZ10E",
        "panasonicFZ10J",
        "goldstarGDO101P",
        "goldstarFC1",
        "sanyoIMP21JTry",
        "sanyoHC21",
        "shootoutAtOldTucson",
        "threeDONTSC1fc2"
      ],
      "default": "panasonicFZ1U",
      "description": "setting.systemtype.about"
    },
    {
      "name": "fontROM",
      "display": "setting.fontrom",
      "type": "enum",
      "options": [
        "none",
        "panasonicFZ1Kanji",
        "panasonicFZ10Kanji"
      ],
      "default": "none",
      "description": "setting.fontrom.about"
    },
    {
      "name": "videoStandard",
      "display": "setting.videostandard",
      "type": "enum",
      "options": [
        "ntsc",
        "pal1",
        "pal2"
      ],
      "default": "ntsc",
      "description": "setting.videostandard.about"
    },
    {
      "name": "port1",
      "display": "setting.port1",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse",
        "flightStick",
        "lightGun",
        "arcadeLightGun",
        "orbatakTrackball"
      ],
      "default": "gamepad",
      "description": "setting.port1.about"
    },
    {
      "name": "port2",
      "display": "setting.port2",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse",
        "flightStick",
        "lightGun",
        "arcadeLightGun",
        "orbatakTrackball"
      ],
      "default": "none",
      "description": "setting.port2.about"
    },
    {
      "name": "randomSeed",
      "display": "setting.randomseed",
      "type": "int",
      "default": 0,
      "description": "setting.randomseed.about"
    }
  ],
