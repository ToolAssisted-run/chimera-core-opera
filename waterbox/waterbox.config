  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".iso": "3DO",
    ".cue": "3DO",
    ".chd": "3DO",
    ".bin": "3DO"
  },
  "settings": [
    {
      "name": "systemType",
      "display": "System Type",
      "type": "enum",
      "options": [
        "panasonicFZ1U",
        "panasonicFZ1E",
        "panasonicFZ1J",
        "panasonicFZ10U",
        "panasonicFZ10E",
        "panasonicFZ10J",
        "goldstarGDO101P",
        "goldstarFC1",
        "sanyoIMP21JTry",
        "sanyoHC21",
        "shootoutAtOldTucson",
        "threeDONTSC1fc2"
      ],
      "default": "panasonicFZ1U",
      "description": "The console model to emulate. This choice decides which BIOS rom the firmware page asks for."
    },
    {
      "name": "fontROM",
      "display": "Font ROM",
      "type": "enum",
      "options": [
        "none",
        "panasonicFZ1Kanji",
        "panasonicFZ10Kanji"
      ],
      "default": "none",
      "description": "An additional Kanji font rom for Japanese titles, asked for on the firmware page when selected."
    },
    {
      "name": "videoStandard",
      "display": "Video Standard",
      "type": "enum",
      "options": [
        "ntsc",
        "pal1",
        "pal2"
      ],
      "default": "ntsc",
      "description": "The video timing and resolution: NTSC 320x240 at 60Hz, PAL1 320x288 at 50Hz, PAL2 384x288 at 50Hz. Pick it to match the game and console region."
    },
    {
      "name": "port1",
      "display": "Controller 1 Type",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse",
        "flightStick",
        "lightGun",
        "arcadeLightGun",
        "orbatakTrackball"
      ],
      "default": "gamepad",
      "description": "What is plugged into the console's port 1."
    },
    {
      "name": "port2",
      "display": "Controller 2 Type",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse",
        "flightStick",
        "lightGun",
        "arcadeLightGun",
        "orbatakTrackball"
      ],
      "default": "none",
      "description": "What is plugged into the console's port 2."
    },
    {
      "name": "randomSeed",
      "display": "Random Seed",
      "type": "int",
      "default": 0,
      "description": "Seeds the console's pseudo-random generators. Upstream falls back to the wallclock without a fixed seed, which can never be allowed in a reproducible machine; movies record this value."
    }
  ],
  "firmware": [
    {
      "id": "panafz1.bin",
      "display": "Panasonic FZ-1 (U) BIOS",
      "description": "The console boot rom for the Panasonic FZ-1 (U) system type (the id is the canonical dump filename).",
      "size": 1048576,
      "sha1": "34BF189111295F74D7B7DFC1F304D98B8D36325A",
      "name": "panafz1.bin",
      "requiredWhen": {
        "setting": "systemType",
        "is": "panasonicFZ1U"
      }
    },
    {
      "id": "panafz1e.bin",
      "display": "Panasonic FZ-1 (E) BIOS",
