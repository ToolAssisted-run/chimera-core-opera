{
  "coreName": "Opera",
  "systemId": "3DO",
  "systemNames": {
    "3DO": "3DO Interactive Multiplayer"
  },
  "author": "Libretro Team (Opera); chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-opera",
  "romFile": "rom.iso",
  "deterministic": true,
  "memoryLayoutMiB": [
    64,
    4,
    8,
    4,
    64
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. Opera mallocs its whole RAM/VRAM/ROM arena (~25MB) plus stream buffers; big allocations land on the mmap heap.",
  "video": {
    "_comment": "buffer CAPACITY; the live size comes from GetVideoWidth/Height per frame (NTSC 320x240, PAL1 320x288, PAL2 384x288, hires doubles).",
    "width": 640,
    "height": 576,
    "virtualWidth": 320,
    "virtualHeight": 240,
    "vsyncNumerator": 3928227,
    "vsyncDenominator": 65536,
    "_vsync_note": "The 3DO's NTSC field rate as opera's own clock keeps it: OPERA_NTSC_FIELD_RATE_1616 over 65536, which is 59.93998718Hz. PAL is exactly 50, and GetVsyncNumerator/Denominator in cinterface.c answer for whichever region the project chose - those are what the engine reads, and these are the answer for a frontend that asks the package instead.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 8192,
    "channels": 2,
    "get": "GetAudio"
  },
  "input": {
    "name": "3DO Controller",
    "_comment": "index order is the wire format: Reset, Previous/Next Disc, then one 42-button device block per port (gamepad, mouse, flight stick, light gun, arcade light gun, trackball - which one a port serves is its port setting). Wider than 64, so everything rides the SetButton channel; the analog inputs ride SetAxis.",
    "buttons": [
      "Reset",
      "Previous Disc",
      "Next Disc",
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 X",
