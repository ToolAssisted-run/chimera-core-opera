+/* Chimera: the tray, opened and closed by a PERSON rather than by a command.
+ *
+ * The state changes are the drive's own EJECT and INJECT commands', and the
+ * host learns of them the way it learns everything else about this drive: from
+ * the status byte every reply carries, and from the "medium changed" attention
+ * raised on the first command after the tray closes (see opera_cdrom_do_cmd).
+ *
+ * WHAT IS DELIBERATELY NOT RAISED is the media access latch, POLRE, which is
+ * what the first version raised on both halves. Traced on Supreme Warrior with
+ * the tray opened at power-on and closed at frame 300: with POLRE the console
+ * never sent the drive another command and never booted the disc; without it,
+ * the BIOS polled READ_ID, watched the status go from "no disc" to "disc in",
+ * re-read the disc info, the TOC and the session, and read from the new disc.
+ * POLRE never raises an interrupt here, and the only other place it is set is
+ * the drive-emulator path immediately before a full console restart - the OS
+ * reads it as the drive going away, and stops talking to it.
+ *
+ * Closing re-reads the disc layout. Swapping the image underneath without that
+ * left the drive describing disc one - its TOC, its capacity - while it read
+ * sectors from disc two, which is not a disc change but a corrupt disc. */
+void
+opera_cdrom_door_open(cdrom_device_t *cd_)
+{
+
+  /* A read in flight is ANSWERED, not dropped: a real drive whose door opens
+   * mid-read fails the read, and this one fails it with the same "disc out" it
+   * gives a read that arrives with the door already open. Dropping it silently
+   * would leave the host waiting for a status that never comes. No trace taken
+   * so far caught a read in flight at the moment the door opened, so this path
+   * is correct by construction rather than by measurement. */
+  const bool reading = (cd_->blocks_requested != 0) ||
+                       (cd_->data_len != 0) ||
+                       g_CDROM_STATE.data.read_status_pending;
+
+  cdrom_data_clear_transfer(cd_);
+  cd_->xbus_status &= ~CDROM_STATUS_DOOR;
+  cd_->xbus_status &= ~CDROM_STATUS_DISC_IN;
+  cd_->xbus_status &= ~CDROM_STATUS_SPIN_UP;
+  cd_->xbus_status &= ~CDROM_STATUS_DOUBLE_SPEED;
+  cd_->xbus_status &= ~CDROM_STATUS_ERROR;
+  cd_->MEI_status   = MEI_CDROM_no_error;
+  if(reading)
+    cdrom_status_tagged_error(cd_,CDROM_CMD_READ_DATA,MEI_CDROM_disc_out);
