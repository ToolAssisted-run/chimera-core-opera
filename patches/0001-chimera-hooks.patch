+
+void
+opera_cdrom_door_close(cdrom_device_t *cd_)
+{
+
+  cdrom_data_clear_transfer(cd_);
+  cd_->xbus_status |= (CDROM_STATUS_READY |
+                       CDROM_STATUS_DOOR |
+                       CDROM_STATUS_DISC_IN |
+                       CDROM_STATUS_SPIN_UP);
+  cd_->xbus_status &= ~CDROM_STATUS_ERROR;
+  cdrom_mode_apply_drive_speed(cd_);
+  cd_->MEI_status = MEI_CDROM_no_error;
+  opera_cdrom_update_disc_layout(cd_);
+  g_chimera_media_changed = true;
+  /* The drive asks for a dipir: XBUS poll bit 0x80, "media access" in
+   * Portfolio's clio.h (this file's POLRE). The OS notices it the next
+   * time it takes the bus, soft-resets into the ROM, and the ROM's dipir
+   * authenticates the new disc and returns - which is the event a
+   * multi-disc title waits for (XBUS "wait for dipir end"). */
+  cdrom_media_access_latch(cd_);
+}
